# Gabarit d'unité systemd --user pour les watchers du bridge (issue #119,
# réactivé et corrigé par l'issue #596).
#
# Une instance par projet actif : le nom du projet est passé via %i.
#   Ex.  watcher@alchess  ->  %i = "alchess"  ->  configs/alchess.conf
#
# Installation : voir installer_services.sh (copie ce fichier dans
# ~/.config/systemd/user/, daemon-reload, enable --now, enable-linger).
#
# Restart=on-failure + SuccessExitStatus=42 (issue #596) : le watcher
# s'éteint proprement avec le code 42 après une période d'inactivité
# (DELAI_INACTIVITE_MIN, issues #199/#200 — voir watcher.py, constante
# EXIT_INACTIVITE). Déclarer 42 en SuccessExitStatus fait traiter cette
# sortie comme un arrêt normal : systemd ne relance PAS le watcher, ce qui
# évite la boucle allumage/extinction constatée avec Restart=always (issue
# #119, abandonné pour cette raison). Un crash réel (tout autre code de
# sortie non nul, ou terminaison par signal) reste, lui, relancé.
#
# Diagnostic :
#   systemctl --user status watcher@alchess
#   journalctl --user -u watcher@alchess -f
#
# PATH explicite (issue #598) : les services systemd --user démarrent avec
# un PATH minimal, sans les ajouts du shell interactif (~/.npm-global/bin,
# où réside `claude`, et ~/Bridge_Agent/venv/bin) — même piège que celui déjà
# rencontré côté CCW/NSSM (voir BRIDGE_AGENT_DOC.md, §16). Sans cette
# directive, une issue échoue immédiatement avec « claude non trouvé dans
# PATH » (constaté en prod après #596). Chemins en dur (pas de `~`, non
# interprété dans les fichiers d'unité) : à adapter si réinstallé sous un
# autre compte/chemin.

[Unit]
Description=Bridge_Agent watcher — %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/alain/Bridge_Agent
Environment="PATH=/home/alain/Bridge_Agent/venv/bin:/home/alain/.npm-global/bin:/home/alain/.local/bin:/home/alain/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games"
ExecStart=/home/alain/Bridge_Agent/venv/bin/python3 watcher.py --config configs/%i.conf
Restart=on-failure
RestartSec=10
SuccessExitStatus=42
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
